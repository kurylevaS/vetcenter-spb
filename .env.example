NEXT_PUBLIC_FRONT_BASE_URL=
NEXT_PUBLIC_FRONT_API_URL=
NEXT_PUBLIC_FRONT_PROXY_API_URL=
NEXT_PUBLIC_BASIC_AUTH_LOGIN=
NEXT_PUBLIC_BASIC_AUTH_PASSWORD=
UNOPTIMIZED_IMAGES=0
ENABLE_SENTRY=0
SENTRY_DSN=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Заявки с сайта (WordPress REST vetcenter/v1/leads + SMS + просмотр /internal/leads/[id])
VETCENTER_LEADS_API_KEY=
# База именно того WordPress, где стоит плагин лидов (без /wp-json на конце).
# Обязательно задайте, если NEXT_PUBLIC_FRONT_API_URL ведёт на другой хост/прокси:
WORDPRESS_LEADS_REST_URL=
# пример: https://api.vetcenterspb.ru — только домен, без /wp-json

# Публичный URL сайта для ссылки в SMS (иначе берётся NEXT_PUBLIC_FRONT_BASE_URL или VERCEL_URL)
# LEADS_PUBLIC_BASE_URL=

# Просмотр заявки на фронте: код и секрет подписи cookie (случайная строка)
LEADS_ADMIN_CODE=
LEADS_SESSION_SECRET=

# SMS провайдер: smsc | mts. Если не задан — при заполненных MTS_OMNI_* + MTS_SMS_SENDER берётся МТС.
# SMS_PROVIDER=mts

# --- МТС Маркетолог (REST Basic): см. документацию в поддержке МТС ---
# MTS_OMNI_LOGIN=
# MTS_OMNI_PASSWORD=
# MTS_SMS_SENDER=
# Опционально: пользовательский class маршрутизации (см. ЛК / поддержку)
# MTS_OMNI_CLASS=

# --- SMSC.ru — API-ключ или логин + пароль (https://smsc.ru/api/http/send/sms/) ---
# SMSC_API_KEY=
SMSC_LOGIN=
SMSC_PASSWORD=

# Номера админов через запятую (79..., без «+»). Для любого провайдера:
SMS_ADMIN_PHONES=
# Совместимость со старым именем:
SMSC_ADMIN_PHONES=

# Дублировать уведомление в Telegram после сохранения лида (опционально)
# LEADS_SEND_TELEGRAM=true

# --- Web Push администратору (страница /internal/push, файл подписок на вашем сервере) ---
# Ключи: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Контакт разработчика или URL сайта (требование спецификации VAPID):
# VAPID_SUBJECT=mailto:admin@example.com
# Абсолютный путь к JSON-массиву подписок (процесс Node должен иметь право на запись):
# PUSH_SUBSCRIPTIONS_FILE=/var/www/vetcenter-spb/data/push-subscriptions.json
